# Copy to backend/.env for LOCAL use only. Never commit the actual key.
# Render: set these variables in the service's Environment panel, then redeploy.
LLM_PROVIDER=openai
LLM_MODEL=replace-with-a-model-id-your-account-can-access
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
DEMO_MODE=false
ALLOW_MODEL_DOWNLOADS=false
USE_FAISS=false
STORAGE_DIR=storage
DATA_DIR=data
HOST=127.0.0.1
PORT=8000
# Optional local alternatives (install models first):
# SPACY_MODEL=en_core_web_sm
# MODEL_ASSISTED_ANALYSIS=true
# LLM_PROVIDER=ollama
# LLM_MODEL=qwen2.5:1.5b
ANALYSIS_MAX_MODEL_CALLS=24
ANALYSIS_TIMEOUT_SECONDS=180
COMPARISON_BATCH_SIZE=40
AGENT_MAX_LLM_CALLS=12
AGENT_TIMEOUT_SECONDS=180
GRAPH_MAX_HOPS=2
EVIDENCE_CONTEXT_LIMIT=24
